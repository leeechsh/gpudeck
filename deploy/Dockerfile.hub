FROM node:22-bookworm AS web
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY index.html tsconfig*.json vite.config.ts ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM rust:1.98-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY --from=web /web/dist ./dist
RUN cargo build --locked --release -p gpudeck-hub

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates sqlite3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/gpudeck-hub /usr/local/bin/gpudeck-hub
COPY deploy/hub-entrypoint.sh /usr/local/bin/hub-entrypoint
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/hub-entrypoint"]
